# --- Admin ---
# Password for /admin (pick something long)
ADMIN_PASSWORD=
# Random string, 32+ characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
# Where contact-form notifications go
CONTACT_TO_EMAIL=ayomikunolopade19@gmail.com
# Sender. The resend.dev test sender can only email the Resend account owner.
# After verifying your own domain, change to e.g. "Oreoluwa <hello@yourdomain.dev>"
FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Set to "true" (only after verifying a domain) to email visitors a thank-you
AUTO_REPLY=false

# --- Storage (Vercel Blob) ---
# Added automatically when a Blob store is connected to the Vercel project.
# Leave empty locally to store data in ./.data instead.
BLOB_READ_WRITE_TOKEN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_USERNAME=
